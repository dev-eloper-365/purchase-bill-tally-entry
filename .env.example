# Copy this file to .env and fill in real values. .env is gitignored.

# Groq API key, used only server-side by tally-bridge.ps1 for AI-assisted
# profiling of unrecognized supplier invoices. Leave blank/omit to disable
# that feature entirely - the rest of the app works fine without it.
GROQ_API_KEY=gsk_your_key_here

# Port TallyPrime's HTTP-XML server listens on. Overrides the port baked
# into config.json's tallyUrl if set.
TALLY_PORT=9000

# Groq chat-completions endpoint used for AI-assisted profiling. Change
# this if you need to point at a different host/IP (e.g. a proxy or a
# self-hosted OpenAI-compatible endpoint) instead of Groq's public API.
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Groq model ID. Groq periodically retires models - if AI profiling starts
# failing, run `curl https://api.groq.com/openai/v1/models -H
# "Authorization: Bearer $GROQ_API_KEY"` to see what's still live.
GROQ_MODEL=openai/gpt-oss-120b
